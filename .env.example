# Server-only local configuration. Never prefix these values with NEXT_PUBLIC_.
LYRICS_ASSIST_BETA_USER_ID=00000000-0000-4000-8000-000000000000
LYRICS_ASSIST_DB_PATH=data/lyrics-assist.db
LYRICS_ASSIST_EXTERNAL_ADAPTER_MODE=stub

# Required only when LYRICS_ASSIST_EXTERNAL_ADAPTER_MODE=openai.
OPENAI_API_KEY=
LYRICS_ASSIST_OPENAI_GENERATION_MODEL=gpt-5.6-terra
LYRICS_ASSIST_OPENAI_SEMANTIC_MODEL=gpt-5.6-terra
LYRICS_ASSIST_OPENAI_READING_MODEL=gpt-5.6-terra
